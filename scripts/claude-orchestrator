#!/usr/bin/env bash
# Start a fresh orchestrator session (workflow/base/roles/orchestrator.md), reachable by Remote Control.
# The outgoing orchestrator has already written its handover note (`bridle handover write`),
# committed it and stopped its watcher and heartbeat. Ticket d4mz; the session opens by running
# `bridle prime orchestrator`, which prints the role prompt, current state and startup steps in
# one go.
# Usage: claude-orchestrator [--project <project>] [extra claude args]
# Project defaults to BRIDLE_PROJECT env var or 'bridle' if unset; it's used in session and
# remote-control names (e.g. 'orch-meta-notes-nuc') and passed to bridle for daemon/token selection.
# Never under a bridle agent (k6b3): a worker's test run once overwrote the live orchestrator's
# pid/session files and used its Remote Control name. Tests stub `claude` and set BRIDLE_LAUNCHER_TEST=1.
if [[ -n "${BRIDLE_AGENT_ID:-}" && -z "${BRIDLE_LAUNCHER_TEST:-}" ]]; then
  echo "$(basename "$0"): refusing to start under a bridle agent (BRIDLE_AGENT_ID is set). Test with 'bash -n', or a stub claude on PATH, a temporary BRIDLE_HOME and BRIDLE_LAUNCHER_TEST=1." >&2
  exit 1
fi
cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)" || exit 1
# A tools-only clone (hw6c, [machine] tools_only in ~/.bridle/config.toml) is not the project's home.
bridle machine tools-only-check || exit 1
# The daemon's supervisor (docs/design/agent-host/orchestrator-supervision.md) reads this pid file:
# "<pid> <process start time> <launch epoch>". The pid is this shell's, which lives exactly as long
# as claude (no `exec`, so the exit can be recorded below). The start time is `ps` lstart, the same
# identity check the daemon uses for agents.
home=${BRIDLE_HOME:-$HOME/.bridle}
mkdir -p "$home" || exit 1
ps_lstart=$(ps -o lstart= -p $$ | xargs)
echo "$$ $ps_lstart $(date +%s)" > "$home/orchestrator.pid"
# The session id changes on /clear, so a SessionStart hook for this session only records the current
# one (and the transcript path) in $BRIDLE_HOME/orchestrator.session.
# Lean start (ticket ct8m, docs/spikes/08-lean-context-findings.md): settings keys that drop bundled
# skills, workflows and the claude.ai connectors, and bare-name denies for tools this role never uses
# (spike 08's usage counts). Kept: AskUserQuestion, Agent, SendMessage (to talk to its subagents),
# ToolSearch, Web*, Monitor and Bash background runs (wait-for-wake), Cron*, ScheduleWakeup. Not
# disableRemoteControl: the human reaches this session through Remote Control.
# One --settings object: the hook plus the lean keys (a second --settings would replace it).
settings='{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"bridle orchestrator note-session"}]}]},"disableBundledSkills":true,"disableWorkflows":true,"disableClaudeAiConnectors":true,"disableArtifact":true,"permissions":{"deny":["EnterPlanMode","ExitPlanMode","DesignSync","NotebookEdit","PushNotification","ReportFindings","RemoteTrigger","Artifact","Workflow"]}}'
# Every bridle command in the session then acts as external:orchestrator, with the token for the
# project it talks to from ~/.bridle/credentials.toml (`bridle token create orchestrator --project <p>`).
export BRIDLE_AS=orchestrator

project="${BRIDLE_PROJECT:-bridle}"
# Parse --project flag if present
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--project" ]]; then
    project="$2"
    shift 2
  else
    break
  fi
done

export BRIDLE_PROJECT="$project"

# Tag this pane so the daemon's orchestrator supervisor can find it.
bridle pane tag orchestrator 2>/dev/null || true

# Session name: 'orch-<project>' by default; can be suffixed with BRIDLE_SESSION_SUFFIX for naming across machines (e.g. 'orch-meta-notes-nuc').
session_suffix=${BRIDLE_SESSION_SUFFIX:+"-$BRIDLE_SESSION_SUFFIX"}
session_name="orch-$project$session_suffix"
# The opening prompt only points at `bridle prime`: a long prompt in argv is matched by any
# `pkill -f <pattern>` a worker runs, and a worker's `pkill -f "just check"` killed two sessions (fx7x).
claude --settings "$settings" --strict-mcp-config --name "$session_name" --remote-control "$session_name" "$@" \
  "Run \`bridle prime orchestrator\` and follow what it prints."
# Sessions have ended unattended with no trace (fx7x): record when, and how (a status above 128 is a
# signal), in the pane and in a log that outlives it.
rc=$?
# A killed claude can't restore the pane's terminal modes; left on they make the next session's
# input fill with focus reports (csfe). Off: focus reporting, bracketed paste, mouse; pop kitty keys.
printf '\e[?1004l\e[?2004l\e[?1000l\e[?1006l\e[>4;0m\e[<u'
how="exit $rc"
if (( rc > 128 )); then
  sig=$((rc - 128))
  case $sig in
    15) sig_name="TERM" ;;
    9)  sig_name="KILL" ;;
    2)  sig_name="INT" ;;
    *)  sig_name=$(kill -l "$sig" 2>/dev/null || echo "$sig") ;;
  esac
  how="$how (SIG$sig_name)"
fi
line="$(date -u +%FT%TZ) $(date '+%-I:%M:%S %p %Z') orchestrator claude ended: $how"
echo "$line" | tee -a "$home/orchestrator.exits"
exit $rc
